# Copy this file to .env and fill in your details.
BASE_URL=https://app.stg.airtm.io
AIRTM_EMAIL=your-email@example.com
AIRTM_PASSWORD=your-password

# Optional: credentials for the mobile app only, if it points to another
# environment (the Play Store app is production). Falls back to the ones above.
MOBILE_AIRTM_EMAIL=
MOBILE_AIRTM_PASSWORD=

# Mobile tests with Appium
APP_PATH=./apps/airtm-staging.apk
# If the app is already installed (e.g. from Play Store), set its package here
# and APP_PATH is ignored. Leave it empty to install the APK from APP_PATH.
APP_PACKAGE=
# Launch activity (only with APP_PACKAGE). Play Store app: .presentation.ui.activity.SplashActivity
APP_ACTIVITY=
DEVICE_NAME=emulator-5554
# If AirTM asks to "VERIFY YOUR DEVICE", seconds the test waits for you to type
# the emailed code on the emulator (0 = fail right away).
DEVICE_VERIFY_WAIT=180
# Emulator created/started by "npm run emulator:create" and "npm run emulator:start".
# airtm_api34 = no Play Store; airtm_playstore_api34 = with Play Store.
AVD_NAME=airtm_api34
# Optional: if not set, wdio.conf.js uses the usual Windows paths.
# JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-17.0.21.10002-hotspot
# ANDROID_HOME=C:\Users\<user>\AppData\Local\Android\Sdk
# Emulator GPU mode: swiftshader_indirect (default) or host.
# EMULATOR_GPU=swiftshader_indirect
