{
  "name": "airtm-tests",
  "version": "1.0.0",
  "description": "AirTM web and mobile E2E tests",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "setup:mobile": "appium driver install uiautomator2",
    "doctor:mobile": "appium driver doctor uiautomator2",
    "appium": "appium",
    "emulator:create": "node scripts/emulator.js create",
    "emulator:start": "node scripts/emulator.js start",
    "emulator:stop": "node scripts/emulator.js stop",
    "test:mobile": "wdio run ./wdio.conf.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@wdio/appium-service": "^10.1.1",
    "@wdio/cli": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "appium": "^3.9.1",
    "appium-uiautomator2-driver": "^8.7.3",
    "webdriverio": "^10.1.0"
  }
}
